# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Chỉ dùng phía server (trang admin) — KHÔNG để lộ ra client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email Google được vào /admin, nhiều email cách nhau dấu phẩy
ADMIN_EMAILS=ban@gmail.com,thuquy@gmail.com

# Tên đội (title trang, ảnh chia sẻ)
NEXT_PUBLIC_TEAM_NAME=fit@hcmus

# Tài khoản nhận quỹ (VietQR). BANK_ID dùng mã ngắn: VCB, TCB, MB, ACB, VPB, TPB, BIDV, ICB (VietinBank)...
NEXT_PUBLIC_BANK_ID=MB
NEXT_PUBLIC_BANK_ACCOUNT=0123456789
NEXT_PUBLIC_BANK_ACCOUNT_NAME=NGUYEN VAN A
